<Project>
	<!-- 本地庫路徑屬性 TswgLibsDir；必須在用到 $(TswgLibsDir) 的 ItemGroup 之前 import。 -->
	<Import Project="$(MSBuildThisFileDirectory)../../TswgLibs.props" />
	<PropertyGroup>
		<AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
		<OutputType>Library</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!-- <LangVersion>preview<LangVersion/> 設此則報錯 NuGet.targets(186,5): error : 无效的
框架标识符“”。 -->
		<NoWarn>CS1998</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="$(MSBuildThisFileDirectory)TypeAlias.cs"/>
		<Compile Include="$(MSBuildThisFileDirectory)GlobalUsing.cs"/>
	</ItemGroup>

	<ItemGroup>
		<!-- 前端 UI 庫一律走 TswgLib 本地專案引用（不再用 NuGet 的 0.3.0-alpha／0.0.2-alpha）。
			 這三件是「寫界面用的糖」，本項目只在這裏宣告一次。 -->
		<ProjectReference Include="$(TswgLibsDir)Avln.Dsl/proj/Tsinswreng.Avln.Dsl/Tsinswreng.Avln.Dsl.csproj" />
		<ProjectReference Include="$(TswgLibsDir)Avln.Grid/proj/Tsinswreng.Avln.Grid/Tsinswreng.Avln.Grid.csproj" />
		<ProjectReference Include="$(TswgLibsDir)Avln.Navi/proj/Tsinswreng.Avln.Navi/Tsinswreng.Avln.Navi.csproj" />
		<!-- <ProjectReference Include="../../../Tsinswreng.CsCore/proj/Tsinswreng.CsCore/Tsinswreng.CsCore.csproj" /> -->
		<!-- <ProjectReference Include="../../../Tsinswreng.CsTools/proj/Tsinswreng.CsTools/Tsinswreng.CsTools.csproj" /> -->
		<!-- <ProjectReference Include="../../../Tsinswreng.CsCfg/proj/Tsinswreng.CsCfg/Tsinswreng.CsCfg.csproj" /> -->
		<ProjectReference Include="$(MSBuildThisFileDirectory)..\..\Ngan.Dict.Core\proj\Ngan.Dict.Core\Ngan.Dict.Core.csproj" />
	</ItemGroup>




	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
	</ItemGroup>
</Project>
