<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0-android</TargetFramework>
		<SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
		<AcceptAndroidSDKLicenses>true</AcceptAndroidSDKLicenses>
		<Nullable>enable</Nullable>
		<ApplicationId>Tsinswreng.Ngan.Dict</ApplicationId>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>1.2.18.26297</ApplicationDisplayVersion>
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
		<!-- 日常 IDE/build 使用 Mono；NativeAOT 由 PublishNativeAot.sh 顯式啓用。 -->
		<UseMonoRuntime>true</UseMonoRuntime>
		<AndroidEnableAot>false</AndroidEnableAot>
		<PublishAot>false</PublishAot>
		<AndroidLinkMode Condition="'$(Configuration)' == 'Debug'">None</AndroidLinkMode>
		<AndroidLinkMode Condition="'$(Configuration)' != 'Debug'">Full</AndroidLinkMode>
		<!-- 启用 ProGuard 混淆（可选，进一步减小体积） -->
		<!-- <AndroidEnableProguard>true</AndroidEnableProguard> -->
		<PublishTrimmed Condition="'$(Configuration)' == 'Debug'">false</PublishTrimmed>
		<PublishTrimmed Condition="'$(Configuration)' != 'Debug'">true</PublishTrimmed>
		<TrimMode>link</TrimMode>

		<!-- 忽略缺失的 prune data，先让发布通过 -->
		<AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>


	</PropertyGroup>

	<!--
		只在 Android 主項目內把腳本開關轉成 NativeAOT 屬性。
		避免命令列的 PublishAot 全局屬性傳入 netstandard 與源生成器 ProjectReference。
	-->
	<PropertyGroup Condition="'$(NganDictAndroidNativeAot)' == 'true'">
		<UseMonoRuntime>false</UseMonoRuntime>
		<AndroidEnableAot>true</AndroidEnableAot>
		<PublishAot>true</PublishAot>
		<PublishTrimmed>true</PublishTrimmed>
		<AndroidLinkMode>Full</AndroidLinkMode>
	</PropertyGroup>

	<!-- NativeAOT 需保留 Java 端間接調用的 TLS trust-manager JNI 回調。 -->
	<ItemGroup Condition="'$(PublishAot)' == 'true'">
		<IlcArg Include="--export-dynamic-symbol:Java_net_dot_android_crypto_DotnetProxyTrustManager_verifyRemoteCertificate" />
		<LinkerArg Include="-Wl,-u,Java_net_dot_android_crypto_DotnetProxyTrustManager_verifyRemoteCertificate" />
	</ItemGroup>
	<ItemGroup>
		<TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
	</ItemGroup>
	<ItemGroup>
		<AndroidResource Include="Icon.png">
			<Link>Resources\drawable\Icon.png</Link>
		</AndroidResource>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia.Android" />
		<PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../Ngan.Dict.Ui/Ngan.Dict.Ui.csproj" />
		<ProjectReference Include="../../../Ngan.Dict.Backend/proj/Ngan.Dict.Backend/Ngan.Dict.Backend.csproj" />
		<ProjectReference Include="../Ngan.Dict.Client/Ngan.Dict.Client.csproj" />
	</ItemGroup>
</Project>
